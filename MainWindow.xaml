<Window x:Class="PhotoQuick.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:domain="clr-namespace:PhotoQuick.Domain"
        xmlns:local="clr-namespace:PhotoQuick"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="PhotoQuick"
        Height="760"
        Width="1180"
        MinHeight="620"
        MinWidth="980"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0B0D10"
        Foreground="#F3F6FA"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        KeyDown="Window_OnKeyDown"
        StateChanged="Window_OnStateChanged">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:SortModeDisplayConverter x:Key="SortModeDisplayConverter" />
        <local:ObjectToVisibilityConverter x:Key="ObjectToVisibilityConverter" />
        <local:ObjectToBooleanConverter x:Key="ObjectToBooleanConverter" />
        <local:BooleanToGridLengthConverter x:Key="BooleanToGridLengthConverter" />

        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0D10" />
        <SolidColorBrush x:Key="ChromeBrush" Color="#171A20" />
        <SolidColorBrush x:Key="PanelBrush" Color="#1C2027" />
        <SolidColorBrush x:Key="PanelBrushAlt" Color="#232832" />
        <SolidColorBrush x:Key="ControlBrush" Color="#2A303B" />
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#343B48" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4BA3FF" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#68B5FF" />
        <SolidColorBrush x:Key="DangerBrush" Color="#E45A5A" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F6FA" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AEB8C6" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#758092" />
        <SolidColorBrush x:Key="StrokeBrush" Color="#323844" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#202631" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}" />

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#26384B" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFD8D8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#512B31" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style x:Key="TopBarButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Height" Value="54" />
            <Setter Property="MinHeight" Value="54" />
            <Setter Property="Padding" Value="16,0" />
        </Style>

        <Style x:Key="BottomBarButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Height" Value="62" />
            <Setter Property="MinHeight" Value="62" />
            <Setter Property="Padding" Value="16,0" />
        </Style>

        <Style x:Key="BottomBarDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
            <Setter Property="Height" Value="62" />
            <Setter Property="MinHeight" Value="62" />
            <Setter Property="Padding" Value="16,0" />
        </Style>

        <Style x:Key="TopBarToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="54" />
            <Setter Property="MinHeight" Value="54" />
            <Setter Property="Width" Value="54" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#26384B" />
                                <Setter Property="Foreground" Value="#CFE7FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#202631" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2A3038" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#363D47" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#A92419" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="92" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="MinHeight" Value="92" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="Foreground" Value="#DCE5F0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3A20242B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#5A2B313B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.25" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemRoot"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}"
                                Margin="4,2">
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="#33485F" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="#264765" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="54" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="MaxDropDownHeight" Value="360" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Root"
                                                Background="{TemplateBinding Background}"
                                                BorderThickness="0"
                                                CornerRadius="0"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="34" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  RecognizesAccessKey="True"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <Viewbox Grid.Column="1"
                                                         Width="10"
                                                         Height="10"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center">
                                                    <Path Stroke="#CFE7FF"
                                                          StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Data="M 2 4 L 5 7 L 8 4" />
                                                </Viewbox>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#26384B" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Background="#202630"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        Padding="3">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemRoot"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="#26303B" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="#263A4F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AutoHideScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Opacity="0"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb"
                                           Background="#80919CAC">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="0" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Opacity="0"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                                <Setter TargetName="Thumb" Property="Background" Value="#C0AEB8C6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AutoHideScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Style="{StaticResource AutoHideScrollBarStyle}"
                                       Orientation="Vertical"
                                       HorizontalAlignment="Right"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="8"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource AppBackgroundBrush}"
            CornerRadius="8"
            ClipToBounds="True">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="62" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ImageColumn" Width="*" MinWidth="360" />
            <ColumnDefinition x:Name="SideSplitterColumn" Width="4" />
            <ColumnDefinition x:Name="SidePanelColumn" Width="348" MinWidth="320" MaxWidth="620" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.ColumnSpan="3"
                Background="#101318"
                BorderThickness="0"
                MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                        <Grid Width="18" Height="18">
                            <Rectangle Width="13"
                                       Height="13"
                                       RadiusX="3"
                                       RadiusY="3"
                                       Fill="#4BA3FF"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Bottom" />
                            <Path Fill="#EAF6FF"
                                  Data="M 3 13 L 7 8 L 10 11 L 12 9 L 16 14 L 3 14 Z" />
                            <Ellipse Width="3"
                                     Height="3"
                                     Fill="#EAF6FF"
                                     Margin="10,3,0,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top" />
                        </Grid>
                    </Viewbox>
                    <TextBlock Text="PhotoQuick"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="最小化"
                            Click="MinimizeButton_OnClick">
                        <Viewbox Width="12" Height="12">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 2 9 L 14 9" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="MaximizeRestoreButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="最大化/还原"
                            Click="MaximizeRestoreButton_OnClick">
                        <Viewbox Width="12" Height="12">
                            <Path x:Name="MaximizeRestoreIcon"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  StrokeLineJoin="Round"
                                  Data="M 3 3 L 13 3 L 13 13 L 3 13 Z" />
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButtonStyle}"
                            ToolTip="关闭"
                            Click="CloseButton_OnClick">
                        <Viewbox Width="12" Height="12">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 3 3 L 13 13 M 13 3 L 3 13" />
                        </Viewbox>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Grid.ColumnSpan="3"
                Background="{StaticResource ChromeBrush}"
                BorderThickness="0">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center">
                    <Button Content="打开文件夹"
                            Style="{StaticResource TopBarButtonStyle}"
                            Command="{Binding OpenFolderCommand}" />
                    <ToggleButton Style="{StaticResource TopBarToggleStyle}"
                                  ToolTip="包含子文件夹"
                                  IsChecked="{Binding RecursiveScan}">
                        <Viewbox Width="18" Height="18">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M 3 4 L 7 4 L 7 7 L 12 7 M 7 7 L 7 13 L 12 13 M 12 5 L 16 7 L 12 9 M 12 11 L 16 13 L 12 15" />
                        </Viewbox>
                    </ToggleButton>
                    <ComboBox Width="168"
                              ItemsSource="{Binding SortModes}"
                              SelectedItem="{Binding SelectedSortMode}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource SortModeDisplayConverter}}"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Style="{StaticResource TopBarButtonStyle}"
                            ToolTip="侧栏"
                            Command="{Binding ToggleSidePanelCommand}">
                        <Viewbox Width="18" Height="18">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeLineJoin="Round"
                                  Data="M 3 4 L 15 4 L 15 14 L 3 14 Z M 8 4 L 8 14" />
                        </Viewbox>
                    </Button>
                </StackPanel>

            </DockPanel>
        </Border>

        <Grid Grid.Row="2"
              Grid.Column="0"
              Background="#050607"
              ClipToBounds="True"
              x:Name="ImageSurface"
              MouseWheel="ImageSurface_OnMouseWheel"
              MouseLeftButtonDown="ImageSurface_OnMouseLeftButtonDown"
              MouseMove="ImageSurface_OnMouseMove"
              MouseLeftButtonUp="ImageSurface_OnMouseLeftButtonUp"
              MouseDown="ImageSurface_OnMouseDown"
              SizeChanged="ImageSurface_OnSizeChanged">
            <Rectangle Fill="#07090C" />

            <Image x:Name="DisplayedImage"
                   Source="{Binding CurrentImage}"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.LayoutTransform>
                    <RotateTransform x:Name="ImageRotate" />
                </Image.LayoutTransform>
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ImageScale" />
                        <TranslateTransform x:Name="ImageTranslate" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <Button Content="‹"
                    Style="{StaticResource NavButtonStyle}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="18,0,0,0"
                    Command="{Binding PreviousCommand}" />
            <Button Content="›"
                    Style="{StaticResource NavButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,18,0"
                    Command="{Binding NextCommand}" />
        </Grid>

        <GridSplitter Grid.Row="2"
                      Grid.Column="1"
                      Width="4"
                      MinWidth="4"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      ShowsPreview="False"
                      Visibility="{Binding ShowSidePanel, Converter={StaticResource BooleanToVisibilityConverter}}"
                      DragCompleted="SidePanelSplitter_OnDragCompleted" />

        <Border Grid.Row="2"
                Grid.Column="2"
                Background="{StaticResource PanelBrush}"
                BorderThickness="0"
                Visibility="{Binding ShowSidePanel, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="FileListRow" Height="*" MinHeight="160" />
                    <RowDefinition Height="4" />
                    <RowDefinition x:Name="FileInfoRow" Height="190" MinHeight="150" MaxHeight="320" />
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0"
                         x:Name="FileListBox"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding CurrentItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ScrollViewer.CanContentScroll="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Loaded="FileListBox_OnLoaded"
                         PreviewMouseWheel="FileListBox_OnPreviewMouseWheel"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.Resources>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource AutoHideScrollViewerStyle}" />
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type domain:ImageItem}">
                            <Grid Margin="10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DirectoryPath}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11"
                                               Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="#223C31"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="0"
                                        Padding="7,3"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding KindText}"
                                               Foreground="#A7F0C7"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <GridSplitter Grid.Row="1"
                              Height="4"
                              MinHeight="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="Transparent"
                              ShowsPreview="False" />

                <Border Grid.Row="2"
                        Padding="16"
                        Background="{StaticResource PanelBrushAlt}"
                        BorderThickness="0">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentItem.FileName, TargetNullValue=未选择文件}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CurrentItem.KindText, StringFormat=格式：{0}, TargetNullValue=格式：-}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,10,0,0" />
                        <TextBlock Text="{Binding CurrentItem.SizeText, StringFormat=大小：{0}, TargetNullValue=大小：-}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="{Binding CurrentItem.LastWriteTimeText, StringFormat=修改时间：{0}, TargetNullValue=修改时间：-}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Grid.ColumnSpan="3"
                Background="{StaticResource ChromeBrush}"
                BorderThickness="0">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center">
                    <Button Content="重命名"
                            Style="{StaticResource BottomBarButtonStyle}"
                            Command="{Binding RenameCommand}" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            Height="62"
                            MinHeight="62"
                            Width="54"
                            IsEnabled="{Binding CurrentImage, Converter={StaticResource ObjectToBooleanConverter}}"
                            ToolTip="顺时针旋转 90°"
                            Click="RotateRightButton_OnClick">
                        <Viewbox Width="19" Height="19">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.55"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M 13.5 5.5 L 16 5.5 L 16 3 M 15.7 5.5 C 14.3 3.7 12.1 2.5 9.5 2.5 C 5.9 2.5 3 5.4 3 9 C 3 12.6 5.9 15.5 9.5 15.5 C 11.4 15.5 13.1 14.7 14.3 13.4 M 8 6.5 L 12 6.5 L 12 10.5 L 8 10.5 Z" />
                        </Viewbox>
                    </Button>
                    <ComboBox Width="330"
                              Height="62"
                              MinHeight="62"
                              ItemsSource="{Binding PresetMoveFolders}"
                              SelectedItem="{Binding SelectedMoveFolder}" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            Height="62"
                            MinHeight="62"
                            Width="48"
                            ToolTip="添加常用目录"
                            Command="{Binding AddPresetFolderCommand}">
                        <Viewbox Width="16" Height="16">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 8 2 L 8 14 M 2 8 L 14 8" />
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            Height="62"
                            MinHeight="62"
                            Width="48"
                            ToolTip="移除常用目录"
                            Command="{Binding RemovePresetFolderCommand}">
                        <Viewbox Width="16" Height="16">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 2 8 L 14 8" />
                        </Viewbox>
                    </Button>
                    <Button Content="移动到目录"
                            Style="{StaticResource BottomBarButtonStyle}"
                            Command="{Binding MoveCommand}" />
                    <Button Style="{StaticResource BottomBarDangerButtonStyle}"
                            ToolTip="删除"
                            Command="{Binding DeleteCommand}">
                        <Viewbox Width="18" Height="18">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M 5 6 L 5.5 15 L 12.5 15 L 13 6 M 3.5 6 L 14.5 6 M 7 6 L 7.5 4 L 10.5 4 L 11 6 M 8 8.5 L 8 13 M 10.5 8.5 L 10.5 13" />
                        </Viewbox>
                    </Button>
                </StackPanel>

            </DockPanel>
        </Border>
    </Grid>
    </Border>
</Window>
